<%
  var hero = theme.hero || {};
  var statusOn = hero.status_card && hero.status_card.enable;
  var authorOn = !theme.author_widget || theme.author_widget.enable !== false;
  var authorName = config.author || '';
  var handle = hero.handle || '';
%>
<% if (statusOn) { %>
<div class="widget-card status-card" id="status-card" hidden>
  <div class="status-header">
    <div class="status-avatar">
      <% if (theme.brand && theme.brand.avatar) { %>
      <img src="<%- url_for(theme.brand.avatar) %>" alt="<%= authorName %>">
      <% } %>
      <span class="status-dot"></span>
    </div>
    <div class="status-identity">
      <div class="status-name-row">
        <span class="status-name"><%= authorName %></span>
      </div>
      <% if (handle) { %><div class="status-handle"><%= handle %></div><% } %>
    </div>
  </div>
  <div class="status-body">
    <div class="status-item">
      <span class="status-icon"><%- partial('_partial/icon', { name: 'pin', size: 14, className: 'status-svg' }) %></span>
      <span class="status-val" id="status-loc"><%= hero.status_card.location %></span>
    </div>
    <div class="status-item">
      <span class="status-icon"><%- partial('_partial/icon', { name: 'activity', size: 14, className: 'status-svg' }) %></span>
      <span class="status-val" id="status-act"><%= hero.status_card.default_act %></span>
    </div>
    <div class="status-item">
      <span class="status-icon"><%- partial('_partial/icon', { name: 'star', size: 14, className: 'status-svg' }) %></span>
      <span class="status-val" id="status-detail"><%= hero.status_card.default_detail %></span>
    </div>
  </div>
  <% if (authorOn) { %>
  <div class="status-links">
    <%- partial('_partial/author-actions', { inline: true }) %>
  </div>
  <% } %>
</div>
<% } else if (authorOn) { %>
<div class="widget-card author-widget author-widget-minimal">
  <%- partial('_partial/author-actions', { inline: true }) %>
</div>
<% } %>

<div class="widget-card contrib-widget" id="contrib-card">
  <div class="widget-title">Contribution</div>
  <div class="contrib-head">
    <div class="contrib-stat">
      <span class="contrib-stat-num" id="contrib-count-7d">—</span>
      <span class="contrib-stat-label">近 7 日活动</span>
    </div>
    <div class="contrib-stat">
      <span class="contrib-stat-num" id="contrib-count-30d">—</span>
      <span class="contrib-stat-label">近 30 日活动</span>
    </div>
  </div>
  <svg class="stat-sparkline contrib-sparkline" viewBox="0 0 80 25" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="contrib-grad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--mint)" />
        <stop offset="100%" stop-color="var(--pink)" />
      </linearGradient>
    </defs>
    <path id="contrib-sparkline-path" fill="none" stroke="url(#contrib-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
  </svg>
  <ul class="contrib-list" id="contrib-recent" aria-label="近期 GitHub 活动">
    <li class="contrib-item contrib-placeholder">正在加载 GitHub 活动…</li>
  </ul>
</div>
