<%
  var posts = site.posts.sort('-date').toArray();
  var idx = posts.findIndex(function(p) { return p.path === page.path; });
  var prev = idx > 0 ? posts[idx - 1] : null;     // 较新
  var next = idx >= 0 && idx < posts.length - 1 ? posts[idx + 1] : null;  // 较旧

  var firstCat = page.categories && page.categories.length ? page.categories.first().name : null;
  var tagArr = page.tags ? page.tags.toArray().map(function(t){ return t.name; }) : [];
  var counterCfg = theme.counter || {};
  var counterOn = !!(counterCfg.enable && (counterCfg.provider || 'busuanzi') === 'busuanzi');
  var showPostViews = counterOn && counterCfg.show_post_views !== false;

  function fmt(date) {
    var d = new Date(date);
    return d.getFullYear() + ' · ' + String(d.getMonth()+1).padStart(2,'0') + ' · ' + String(d.getDate()).padStart(2,'0');
  }
  function readTime(post) {
    var text = (post.content || '').replace(/<[^>]+>/g, '');
    var words = text.length / 3;
    return Math.max(1, Math.round(words / 200)) + ' min';
  }
  // 提取 h2/h3/h4 作为 TOC（注意：hexo 渲染后 heading 已是 HTML）
  var tocHtml = '';
  try {
    var content = page.content || '';
    var re = /<h([234])[^>]*id="([^"]+)"[^>]*>([\s\S]*?)<\/h\1>/g;
    var m, tocs = [];
    while ((m = re.exec(content)) !== null) {
      tocs.push({ level: Number(m[1]), id: m[2], text: m[3].replace(/<[^>]+>/g, '').trim() });
    }
    if (tocs.length > 0) {
      tocHtml = tocs.map(function(t) {
        return '<a href="#' + t.id + '" class="toc-item toc-h' + t.level + (t.level === 2 ? '' : '') + '">' + t.text + '</a>';
      }).join('');
    }
  } catch (e) {}
%>

<div class="post-layout">
  <article>
    <div class="post-header">
      <div class="post-breadcrumb">
        <a href="<%- url_for('/archives/') %>">Writing</a>
        <% if (firstCat) { %> / <a href="<%- url_for('/categories/' + firstCat + '/') %>"><%= firstCat %></a><% } %>
      </div>
      <h1><%= page.title %></h1>
      <div class="post-info">
        <span class="post-info-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <%= fmt(page.date) %>
        </span>
        <span class="post-info-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <%= readTime(page) %> 阅读
        </span>
        <% if (showPostViews) { %>
        <span class="post-info-item post-view-counter" id="busuanzi_container_page_pv">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/></svg>
          <span class="counter-value" id="busuanzi_value_page_pv" aria-live="polite">—</span> 次阅读
        </span>
        <% } %>
        <% if (page.updated && String(page.updated) !== String(page.date)) { %>
        <span class="post-info-item">更新于 <%= fmt(page.updated) %></span>
        <% } %>
      </div>
      <div class="post-tags">
        <% if (firstCat) { %><span class="tag <%= cat_tag_class(firstCat) %>"><%= firstCat %></span><% } %>
        <% tagArr.forEach(function(t) { %><span class="tag-text">#<%= t %></span><% }); %>
      </div>
    </div>

    <% if (page.cover) { %>
    <img class="post-cover" src="<%- url_for(page.cover) %>" alt="<%= page.title %>" loading="lazy" decoding="async">
    <% } else { %>
    <%- star_cover(page.title || page.path) %>
    <% } %>

    <div class="post-body">
      <%- page.content %>
    </div>

    <div class="post-footer-nav">
      <% if (next) { %>
      <a href="<%- url_for(next.path) %>" class="nav-card prev">
        <div class="nav-card-label">← 上一篇</div>
        <div class="nav-card-title"><%= next.title %></div>
      </a>
      <% } else { %>
      <div class="nav-card prev placeholder"><div class="nav-card-label">← 上一篇</div><div class="nav-card-title">没有更早的文章了</div></div>
      <% } %>
      <% if (prev) { %>
      <a href="<%- url_for(prev.path) %>" class="nav-card next">
        <div class="nav-card-label">下一篇 →</div>
        <div class="nav-card-title"><%= prev.title %></div>
      </a>
      <% } else { %>
      <div class="nav-card next placeholder"><div class="nav-card-label">下一篇 →</div><div class="nav-card-title">最新的文章就是这一篇</div></div>
      <% } %>
    </div>
  </article>

  <aside class="post-sidebar">
    <% if (tocHtml) { %>
    <div class="sidebar-card">
      <div class="sidebar-title">目录</div>
      <div class="toc"><span class="toc-slug" aria-hidden="true"><i class="toc-slug-body"></i></span><%- tocHtml %></div>
    </div>
    <% } %>
    <%- partial('_partial/author-widget') %>
  </aside>
</div>

<script>
// 阅读进度 + 目录高亮：合并为单个 rAF 节流的滚动处理，滚动更顺、不掉帧
(function () {
  const bar = document.getElementById('read-progress');
  const items = Array.from(document.querySelectorAll('.toc-item'));
  const slug = document.querySelector('.toc-slug');
  const sections = items
    .map(i => ({ el: i, target: document.getElementById(i.getAttribute('href').slice(1)) }))
    .filter(s => s.target);
  let ticking = false;
  let lastEl = null;

  // 高亮是一枚液体弹丸：静止时就是原来的胶囊，没有任何形态变化；
  // 液体感只在运动里——整体旅行（不跨越拉伸），流速最快时体积守恒地
  // 拉长变细（.flow 动画），到达时位置过冲回稳；时长随距离伸缩（恒定流速）。
  function indicatorMove(item) {
    const railLeft = getComputedStyle(item).getPropertyValue('--toc-rail-left').trim() || '0px';
    const y1 = item.offsetTop, h1 = item.offsetHeight;
    slug.classList.add('on');
    if (!lastEl) {
      // 首帧 / resize / 字体换载后的归位：瞬时到位，不放动画
      slug.classList.add('instant');
      slug.style.left = railLeft;
      slug.style.transform = 'translateY(' + y1 + 'px)';
      slug.style.height = h1 + 'px';
      requestAnimationFrame(() => requestAnimationFrame(() => slug.classList.remove('instant')));
      return;
    }
    const cs = getComputedStyle(slug);
    const y0 = (cs.transform === 'none' ? 0 : new DOMMatrixReadOnly(cs.transform).m42) || 0;
    const dur = Math.min(0.85, Math.max(0.22, Math.abs(y1 - y0) / 320));
    slug.style.transitionDuration = dur + 's';
    slug.style.setProperty('--flow-dur', dur + 's');
    slug.style.left = railLeft;
    slug.style.transform = 'translateY(' + y1 + 'px)';
    slug.style.height = h1 + 'px';
    // 重触流动画（去类 → 强制重排 → 加类）
    slug.classList.remove('flow');
    void slug.offsetWidth;
    slug.classList.add('flow');
  }

  function update() {
    ticking = false;
    const doc = document.documentElement;
    if (bar) {
      const max = doc.scrollHeight - doc.clientHeight;
      bar.style.width = (max > 0 ? (doc.scrollTop / max) * 100 : 0) + '%';
    }
    if (sections.length) {
      let active = sections[0];
      for (const s of sections) {
        if (s.target.getBoundingClientRect().top < 120) active = s;
      }
      items.forEach(i => i.classList.toggle('active', i === active.el));
      if (slug && active.el !== lastEl) {
        indicatorMove(active.el);
        lastEl = active.el;
      }
    }
  }
  function onScroll() {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  // resize / 字体子集换载后条目高度可能变化：作废缓存，下次更新直接归位
  window.addEventListener('resize', () => { lastEl = null; onScroll(); }, { passive: true });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { lastEl = null; update(); });
  update();
})();
</script>
